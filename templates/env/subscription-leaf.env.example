# Reality residential subscription leaf — environment.
# Copy to /etc/anyreality-resi-stack/subscription-leaf.env on the server, then
# chmod 600 and chown root. systemd reads this file as root before dropping to
# the unprivileged anyreality-sub user, so it must NOT be readable by that user.

# Where to bind the subscription HTTP server.
HOST=0.0.0.0
PORT=80

# Path-prefix token. Clients fetch http://<server>/<TOKEN>/<file>.
# Generate fresh: uuidgen
TOKEN=REPLACE_SUB_TOKEN

# Network interface to read /sys/class/net/<iface>/statistics for traffic accounting.
# Find yours with: ip route get 1.1.1.1
INTERFACE=eth0

# Persistent state file (billing-period rollover counter).
STATE_FILE=/var/lib/anyreality-resi-stack/usage-state.json

# Bytes already spent before this counter started (calibration). 0 if fresh.
USAGE_OFFSET_BYTES=0

# Provider billing reset day. 1 = calendar month; 11 = periods like May 11 to Jun 10.
BILLING_CYCLE_DAY=1

# How often the service samples interface counters even when no client pulls the URL.
USAGE_POLL_INTERVAL_SECONDS=60

# Count bytes already present in the current boot on first state creation.
# Keep true if you want to match the provider dashboard as closely as possible.
COUNT_CURRENT_BOOT_ON_INIT=true

# Plan quota in bytes (e.g. 1063004405760 = 990 GiB). 0 hides the bar.
TOTAL_BYTES=0

# Plan expiry as Unix timestamp. 0 = never.
EXPIRE_TS=0

# Display name shown in clients that honor Profile-Title header.
PROFILE_TITLE=Reality-Residential

# Suggested update interval (hours) for clients that honor Profile-Update-Interval.
UPDATE_INTERVAL_HOURS=24

# Per-client socket timeout. Keeps slow or abandoned HTTP clients from pinning
# subscription worker threads forever.
REQUEST_TIMEOUT_SECONDS=10

# Directory of profile files (clash YAML, sing-box JSON, etc.) to serve.
FILE_DIR=/etc/anyreality-resi-stack/files

# Default file when client requests just /<TOKEN>/ with no filename.
# AnyReality (default) serves a sing-box config: profile.json
# VLESS+Vision (legacy) serves a Clash profile: profile.yaml
DEFAULT_TARGET=profile.json

# ── Optional TLS ─────────────────────────────────────────────────────────
# The subscription URL is a credential: the profile behind it contains the node
# password. Over plain HTTP anyone on the path can read both. Set BOTH of these
# to serve HTTPS instead — it needs a certificate for a real hostname, which an
# IP-only deployment does not have, so it is opt-in.
# The service runs as the unprivileged `anyreality-sub` user; the installer
# grants it group read access to these files when you pass --sub-tls-cert.
# TLS_CERT_FILE=/etc/letsencrypt/live/sub.example.com/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/sub.example.com/privkey.pem
