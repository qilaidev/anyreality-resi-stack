{
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-ws-in",
      "listen": "127.0.0.1",
      "listen_port": 18443,
      "users": [
        {
          "uuid": "00000000-0000-0000-0000-000000000000"
        }
      ],
      "transport": {
        "type": "ws",
        "path": "/example-ws-path",
        "max_early_data": 2048,
        "early_data_header_name": "Sec-WebSocket-Protocol"
      },
      "multiplex": {
        "enabled": true,
        "padding": false
      }
    }
  ]
}
